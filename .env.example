# Copy to ".env" in the same folder as docker-compose.yml and fill in values.
# These are read by the container at startup; do NOT commit the real .env.

# Inverter IP on your LAN (Modbus TCP). Overrides the appsettings.json default.
INVERTER_IP=10.30.51.91

# Where the panels are (decimal degrees), for the solar forecast. Optional: the
# image default is a rounded place about 6 km wide, which the forecast barely
# notices. This repository is public: keep the exact values here, never in it.
SOLAR_LATITUDE=
SOLAR_LONGITUDE=

# Password for the dashboard login screen (also accepted as an X-Api-Key header
# by scripts). Entered once per browser; a 30-day encrypted session cookie is
# issued, the password itself is never stored on the client. Pick something
# long. Leave empty ONLY for trusted localhost use.
APP_AUTH_TOKEN=

# Tibber personal access token (prices) — https://developer.tibber.com
TIBBER_TOKEN=

# Tibber Data API OAuth client (connected-car / charger telemetry)
TIBBER_DATAAPI_CLIENT_ID=
TIBBER_DATAAPI_CLIENT_SECRET=

# Charge Amps portal login (my.charge.space)
CHARGEAMPS_EMAIL=
CHARGEAMPS_PASSWORD=
