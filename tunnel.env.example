# Only if you use the cloudflared service in docker-compose.yml.
# Copy to tunnel.env (git-ignored) next to docker-compose.yml on the NAS.
#
# The token of your Cloudflare Tunnel: Cloudflare Zero Trust > Networks >
# Tunnels > your tunnel, the long string after "--token" in the install
# command. Only the string itself: not the whole command, no quotes.
#
# This is a separate file from .env on purpose, so the tunnel container never
# gets anything but its own token.
TUNNEL_TOKEN=
